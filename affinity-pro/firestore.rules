rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Activation codes: anyone can read a specific code by ID (requires knowing the exact key)
    // and delete it after single-use consumption. Creating/updating codes is admin-only via SDK.
    match /activationCodes/{code} {
      allow read, delete: if true;
      allow create, update: if false;
    }

    // AI knowledge base: readable by anyone, not writable from the client
    match /ai_knowledge/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Purchase requests: clients create and read their own; only Admin SDK can approve/reject
    match /purchaseRequests/{requestId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Key activations: clients read/create/update (device tracking); never delete from client
    match /keyActivations/{code} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
